---
import { getCollection, render } from "astro:content";
import { formatDate } from "../../lib/helpers";
import BasicLayout from "../../layouts/BasicLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

const entry = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(entry);
const title = entry.data.title ?? entry.id;
const pubDate = entry.data.pubDate;
---

<BasicLayout
  title={`${title} - Bhurinat Wangsutthitham`}
  description={entry.data.description ?? "Blog post"}
>
  <main class="mx-auto max-w-3xl w-full h-screen p-8 text-neutral-100">
    <a
      href="/blog"
      class="text-white bg-neutral-900 hover:bg-neutral-800 px-4 py-2 border-1 border-solid border-neutral-600 rounded-lg mb-8"
    >Back</a>
    <div class="my-10">
      <h1 class="text-5xl font-semibold">{title}</h1>
      <div class="flex justify-between pt-4 text-gray-500 text-sm">
        {pubDate && <p>{formatDate(new Date(pubDate))}</p>}
        {remarkPluginFrontmatter.minutesRead && (
          <span>{remarkPluginFrontmatter.minutesRead}</span>
        )}
      </div>
    </div>
    <article class="pb-8 prose prose-slate prose-invert">
      <Content />
    </article>
  </main>
</BasicLayout>
