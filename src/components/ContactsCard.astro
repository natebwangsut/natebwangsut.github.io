---
import Card from "./Card/index.astro";
import Link from "./Link/index.astro";
import { LINKS } from "../lib/constants";

const socials = [
  { label: "LinkedIn", href: LINKS.linkedin },
  { label: "GitHub", href: LINKS.github },
];
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-4" title="Contacts">
  <address class="flex flex-col mt-4 not-italic">
    <h2 class="text-gray-500">Email</h2>
    <Link href="mailto:nate.bwangsut@gmail.com">nate.bwangsut@gmail.com</Link>
  </address>
  <div class="flex flex-col mt-4 w-fit">
    <h2 class="text-gray-500">Socials</h2>
    <ul>
      {socials.map(({ label, href }) => (
        <li>
          <Link href={href}>{label}</Link>
        </li>
      ))}
    </ul>
  </div>
</Card>
