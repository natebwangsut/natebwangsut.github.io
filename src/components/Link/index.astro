---
interface Props {
  href?: string;
  class?: string;
}

const { href, class: className } = Astro.props;
---

<a
  class:list={[
    "text-primary-400 hover:text-primary-300 transition-colors duration-200 ease-in-out",
    className,
  ]}
  href={href}
  rel="noopener noreferrer"
  target="_blank"><slot /></a
>
